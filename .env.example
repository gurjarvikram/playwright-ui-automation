# Copy to .env and adjust. .env is gitignored; never commit real credentials.
# Every value here has a working default — an empty .env runs the full suite against
# production with a headless Chromium.

# --- Target environment ---------------------------------------------------------------

# Which entry of config/environments.json to run against. An unknown name fails the run
# immediately rather than silently falling back.
TEST_ENV=production

# Ad-hoc base URL override. Wins over TEST_ENV — use it for a review app or a local build.
# SAUCE_BASE_URL=https://pr-42.review.example.com

# --- Credentials ----------------------------------------------------------------------

# Overrides the standard user only. Accounts named by a scenario (lockedOut, problem, ...)
# come from fixtures/users.json, because those scenarios are about that account's behaviour.
# These are saucedemo's public demo credentials.
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# --- Browser --------------------------------------------------------------------------

# chromium | firefox | webkit
BROWSER=chromium

# Set to false to watch the browser while debugging. Anything else means headless.
HEADLESS=true

# --- Execution ------------------------------------------------------------------------

# Cucumber workers. 0 runs serially; CI defaults to 4. Overrides the cucumber.js default.
CUCUMBER_WORKERS=0

# Optional tag expression, e.g. "@smoke" or "@login and not @negative". Empty runs everything.
CUCUMBER_TAGS=

# --- Failure artefacts ------------------------------------------------------------------

# off | retain-on-failure | on
# Traces are cheap and turn "it failed in CI" into a step-by-step replay, so they default on.
TRACE=retain-on-failure

# Video is expensive, so it defaults to off locally and retain-on-failure in CI.
VIDEO=off

# Where traces and videos are written. Gitignored.
ARTIFACTS_DIR=artifacts

# --- Logging ----------------------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info

# Set to json for one JSON object per line, for log shippers that parse rather than read.
LOG_FORMAT=text
