{
  "name": "playwright-automation",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:login": "cucumber-js --tags @login",
    "test:navigation": "cucumber-js --tags @navigation",
    "test:product": "cucumber-js --tags @product",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report": "npm test; npm run report:generate && npm run report:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.5.2",
    "allure-commandline": "^2.30.0",
    "allure-cucumberjs": "^3.0.0"
  },
  "dependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@faker-js/faker": "^9.0.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.47.0"
  }
}
